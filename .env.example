# Origin FTP host/IP — keep out of git (Cloudflare hides this on HTTPS).
JAVP_FTP_HOST=
JAVP_FTP_PORT=21
JAVP_FTP_USER=javp
JAVP_FTP_PASS=
JAVP_FTP_DIR=/
# Public CDN URL (safe to commit / share)
JAVP_PUBLIC_BASE=https://updater.javp.app
# Sideload update channel for deploy_update.py: stable | dev
JAVP_UPDATE_CHANNEL=stable

# Dedicated FTP for web.javp.app (preferred). Account home = site docroot.
JAVP_WEB_FTP_HOST=
JAVP_WEB_FTP_PORT=21
JAVP_WEB_FTP_USER=javpweb
JAVP_WEB_FTP_PASS=
JAVP_WEB_FTP_DIR=/
JAVP_WEB_PUBLIC_BASE=https://web.javp.app
# Fallback only (no JAVP_WEB_FTP_HOST): nest under updater FTP as subdirectory
# JAVP_WEB_FTP_DIR=web

# Google Play Developer API (Play Console service account JSON)
# PLAY_SERVICE_ACCOUNT_JSON=android/play-service-account.json
# PLAY_PACKAGE=com.javp.javp
# PLAY_TRACK=internal
# GitHub Actions (publish-play.yml): repo secret PLAY_SERVICE_ACCOUNT_JSON
# with the JSON file contents (not a path).
