.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# libtorrent_flutter native rebuild scratch (keep prebuilt/*.so)
packages/libtorrent_flutter/native-build/
# Desktop prebuilts are fetched at build time, not vendored (25MB+ each).
packages/libtorrent_flutter/prebuilt/linux/
packages/libtorrent_flutter/prebuilt/windows/
packages/libtorrent_flutter/prebuilt/macos/
# rqbit_engine desktop prebuilts are local-only; Android .so files are vendored for CI.
packages/rqbit_engine/prebuilt/linux/
packages/rqbit_engine/prebuilt/windows/
packages/rqbit_engine/prebuilt/macos/
packages/rqbit_engine/rust/target/

# Local debug dumps / source art — never commit
tool_vod_*.json
tool_vod_*.txt
*.m3u
*.m3u8
/JAVP-logo.png
*.apk
*.aab

# Deploy secrets / local publish scratch
.env
.env.*
!.env.example
build/deploy/
android/play-service-account.json
play-service-account.json
android/key.properties
*.jks
*.p12
*.keystore
upload-keystore.jks

# Local screenshots
.shots/

